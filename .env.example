# OpenRouter provider configuration for the local backend .env (gitignored,
# never committed — copy what you need from here into it). Not a full
# reference of every env var this project reads; see
# dana/core/model_provider.py and deploy/space_README.md for the complete
# provider-selection story (Groq/Gemini/OpenAI/the local gateway/Ollama).

DANA_CLOUD_PRIMARY=1
DANA_CLOUD_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Comma-separated list = automatic failover: the first model is primary,
# every model after it rides along as OpenRouter's own server-side `models`
# cascade array, so a 429/5xx on the primary retries the next one upstream
# with no round trip back to this process.
DANA_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,openai/gpt-oss-120b:free,openrouter/free
OPENROUTER_SITE_URL=http://localhost:1420
OPENROUTER_APP_TITLE="Dānā CAD Agent (Local)"
