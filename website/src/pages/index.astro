---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import LiveHfSimulator from "../components/LiveHfSimulator.astro";
import BentoGrid from "../components/BentoGrid.astro";
import CadArchitecture from "../components/CadArchitecture.astro";
import SpindleViewer from "../components/SpindleViewer.astro";
import TerminalReveal from "../components/TerminalReveal.astro";
---

<BaseLayout path="/">
  <SiteHeader />
  <main>
    <Hero />
    <LiveHfSimulator />
    <BentoGrid />
    <CadArchitecture />
    <SpindleViewer />
    <TerminalReveal />

    <section class="border-t border-slate-800/80 bg-ink-900/30">
      <div class="mx-auto max-w-6xl px-6 py-20" data-reveal>
        <h2 class="text-2xl font-semibold text-white sm:text-3xl">
          System requirements
        </h2>
        <p class="mt-3 max-w-2xl text-slate-400">
          Dānā ships as a Windows-first, CUDA-accelerated control plane.
        </p>
        <dl class="mt-10 grid gap-8 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-soft">
              OS
            </dt>
            <dd class="mt-2 text-sm text-slate-300">Windows 10 / 11 (x64)</dd>
          </div>
          <div>
            <dt
              class="text-xs font-semibold uppercase tracking-[0.18em] text-amber"
            >
              GPU
            </dt>
            <dd class="mt-2 text-sm text-slate-300">
              NVIDIA RTX · 8GB+ VRAM recommended
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
              Stack
            </dt>
            <dd class="mt-2 text-sm text-slate-300">
              PyTorch CUDA float16 · Ollama · LangGraph
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
              Privacy
            </dt>
            <dd class="mt-2 text-sm text-slate-300">
              local · offline-first · no cloud STT by default
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
