---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import LiveHfSimulator from "../components/LiveHfSimulator.astro";
import BentoGrid from "../components/BentoGrid.astro";
import CadArchitecture from "../components/CadArchitecture.astro";
import PartViewer from "../components/PartViewer.astro";
import TerminalReveal from "../components/TerminalReveal.astro";
---

<BaseLayout path="/">
  <SiteHeader />
  <main>
    <Hero />
    <LiveHfSimulator />
    <BentoGrid />
    <CadArchitecture />
    <PartViewer />
    <TerminalReveal />

    <section class="border-t border-slate-800/80 bg-ink-900/30">
      <div class="mx-auto max-w-6xl px-6 py-20" data-reveal>
        <h2 class="text-2xl font-semibold text-white sm:text-3xl">
          What it runs on
        </h2>
        <p class="mt-3 max-w-2xl text-slate-400">
          A FastAPI server, a React/Tauri desktop app and a headless FreeCAD kernel.
        </p>
        <dl class="mt-10 grid gap-8 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-soft">
              OS
            </dt>
            <dd class="mt-2 text-sm text-slate-300">
              Windows 10 / 11 recommended; the server and test suite also run on Linux (CI)
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-amber">
              GPU
            </dt>
            <dd class="mt-2 text-sm text-slate-300">
              Optional. An 8 GB card runs qwen2.5-coder:14b locally; cloud models need none
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
              Stack
            </dt>
            <dd class="mt-2 text-sm text-slate-300">
              FreeCAD (headless FreeCADCmd) · FastAPI + WebSockets · React/Tauri · Ollama
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
              Models
            </dt>
            <dd class="mt-2 text-sm text-slate-300">
              Local Ollama, or DeepSeek, Gemini, OpenRouter and Groq, picked per turn by one routing file; <code class="font-mono text-teal">DANA_FREE_ONLY</code> keeps every turn at $0
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
              Tests
            </dt>
            <dd class="mt-2 text-sm text-slate-300">
              1,595 pytest cases, Playwright UI tests and five offline agent evals, blocking in CI — no live model or GPU needed
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
              License
            </dt>
            <dd class="mt-2 text-sm text-slate-300">
              AGPL-3.0, published as an engineering portfolio piece
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
