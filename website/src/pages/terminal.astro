import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HfDemoPlaceholder from "../components/HfDemoPlaceholder.astro";
---

<BaseLayout
  title="Dānā Terminal — Live Agent Shell"
  description="Chat with the Dānā Hugging Face Space from any page over its Gradio API."
