---
/**
 * Hero's split-screen panel: the tool calls of a real session (the
 * Phase 8 free-tier live run of this prompt), typed out with the same
 * scroll-gated engine as TerminalReveal.astro (../scripts/terminal_type).
 */
const lines = [
  "$ a 40x30x10 mm mounting plate with a centered 4 mm radius through-hole",
  "→ create_plan  4 tasks",
  "→ create_freecad_box  40 × 30 × 10",
  "→ create_freecad_cylinder  r 4 · h 10 · base at (20, 15, 0)",
  "→ perform_freecad_boolean  cut",
  "✓ query_topology  7 faces · 11,500.57 mm³",
  "$ Parameters › length 40 → 60 · Apply & Rebuild",
  "✓ rebuilt from the call log · 0 LLM tokens",
];
---

<div
  data-reveal
  class="dana-terminal-surface w-full max-w-md overflow-hidden rounded-none shadow-teal-glow"
  style="min-height: 18rem"
>
  <div class="flex items-center gap-2 border-b border-ink-600 bg-ink-800 px-4 py-3">
    <span class="h-2 w-2 bg-rose-500/80"></span>
    <span class="h-2 w-2 bg-amber"></span>
    <span class="h-2 w-2 bg-teal"></span>
    <span class="ms-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate-500">
      dana · cad session
    </span>
  </div>
  <pre
    id="hero-terminal"
    class="h-[15rem] overflow-x-auto overflow-y-hidden p-5 font-mono text-[12.5px] leading-relaxed text-[#abb2bf] sm:text-sm"
    data-lines={JSON.stringify(lines)}
    aria-live="polite"
  ><span class="tok-comment">// scroll into view to replay</span></pre>
</div>

<script>
  import { initTypingTerminal } from "../scripts/terminal_type";
  initTypingTerminal("hero-terminal");
</script>
