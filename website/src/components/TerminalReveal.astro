---
/**
 * Mock routing terminal — typing starts only when scrolled into view.
 * Fixed min-height reserves space (no CLS). Vanilla JS only.
 */
const lines = [
  "$ dana engage --mode developer",
  "Status: ACTIVE (Variables Locked)",
  "$ route \"draft_cursor_prompt: fix OCR bounds\"",
  "→ MoA_Reasoner  intent=draft_cursor_prompt",
  "→ ticket_validate  OK",
  "→ jason_ticket_review  critique ready",
  "→ ticket_approval  HITL interrupt",
  "→ tools  patch_ledger.md  [PENDING]",
  "OK: The ticket is on the board.",
];
---

<section id="routing" class="border-t border-slate-800/80">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div data-reveal class="max-w-2xl">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">
        Routing you can watch.
      </h2>
      <p class="mt-3 text-slate-400">
        LangGraph corridor from utterance to ledger — validate, critique, approve,
        then write.
      </p>
    </div>

    <div
      data-reveal
      class="dana-terminal-surface mt-10 overflow-hidden rounded-none"
      style="min-height: 22rem"
    >
      <div
        class="flex items-center gap-2 border-b border-ink-600 bg-ink-800 px-4 py-3"
      >
        <span class="h-2 w-2 bg-rose-500/80"></span>
        <span class="h-2 w-2 bg-amber"></span>
        <span class="h-2 w-2 bg-teal"></span>
        <span class="ms-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate-500"
          >dana · offline router</span
        >
      </div>
      <pre
        id="dana-terminal"
        class="h-[18rem] overflow-hidden p-5 font-mono text-[13px] leading-relaxed text-[#abb2bf] sm:text-sm"
        data-lines={JSON.stringify(lines)}
        aria-live="polite"
      ><span class="tok-comment">// scroll into view to replay</span></pre>
    </div>
  </div>
</section>

<script>
  const el = document.getElementById("dana-terminal");
  if (el) {
    const raw = el.getAttribute("data-lines") || "[]";
    /** @type {string[]} */
    let lines = [];
    try {
      lines = JSON.parse(raw);
    } catch {
      lines = [];
    }

    const reduce =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const colorize = (line) => {
      const esc = line
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
      if (esc.startsWith("$")) {
        return `<span class="tok-accent">${esc}</span>`;
      }
      if (esc.startsWith("→")) {
        return `<span class="tok-fn">${esc}</span>`;
      }
      if (esc.startsWith("OK:") || esc.includes("OK")) {
        return `<span class="tok-string">${esc}</span>`;
      }
      if (esc.includes("HITL") || esc.includes("interrupt")) {
        return `<span class="tok-warn">${esc}</span>`;
      }
      if (esc.startsWith("Status:")) {
        return `<span class="tok-keyword">${esc}</span>`;
      }
      return esc;
    };

    const renderAll = () => {
      el.innerHTML = lines.map(colorize).join("\n");
    };

    const typeLines = async () => {
      /** @type {string[]} */
      const done = [];
      for (const line of lines) {
        let partial = "";
        for (let i = 0; i < line.length; i += 1) {
          partial += line[i];
          el.innerHTML =
            done.map(colorize).join("\n") +
            (done.length ? "\n" : "") +
            colorize(partial);
          await new Promise((r) => setTimeout(r, 12 + (i % 3)));
        }
        done.push(line);
        el.innerHTML = done.map(colorize).join("\n") + "\n";
        await new Promise((r) => setTimeout(r, 180));
      }
    };

    if (reduce) {
      renderAll();
    } else if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.disconnect();
            void typeLines();
          }
        },
        { threshold: 0.35 },
      );
      io.observe(el);
    } else {
      void typeLines();
    }
  }
</script>
