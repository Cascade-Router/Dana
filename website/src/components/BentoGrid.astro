---
const features = [
  {
    title: "Meta-Broker corridor",
    body: "Isolated multi-epic orchestration with live task tracking — submit /broker goals and stream telemetry.",
    span: "md:col-span-2",
    accent: "teal",
  },
  {
    title: "Offline-first routing",
    body: "Local Ollama hops by default. Fail closed, audit every stage, keep the control plane on your machine.",
    span: "",
    accent: "amber",
  },
  {
    title: "Artifact manifest",
    body: "Exports land in .dana_scratch with structured manifests — terminal-readable, not form chrome.",
    span: "",
    accent: "teal",
  },
  {
    title: "Hardware control plane",
    body: "Windows-native stack with CUDA acceleration paths, kill switch, and actuator jail for heavy tools.",
    span: "md:col-span-2",
    accent: "amber",
  },
];
---

<section id="features" class="border-t border-ink-600 bg-ink-800/40">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div data-reveal class="max-w-2xl">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">
        Built like a control surface, not a chatbot.
      </h2>
      <p class="mt-3 text-slate-400">
        Perception, routing, and actuation — composed as a cybernetic stack you can
        audit offline.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
      {
        features.map((f) => (
          <article data-reveal class:list={["bento-card", f.span]}>
            <div
              class:list={[
                "mb-4 h-1 w-12",
                f.accent === "teal" ? "bg-teal" : "bg-amber",
              ]}
            />
            <h3 class="text-lg font-semibold text-white">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
