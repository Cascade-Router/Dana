---
const features = [
  {
    title: "Zero-token parametric rebuilds",
    body: "Every CAD call is recorded in one typed IR. Change a dimension in the Parameters tab and Dānā replays the recorded steps without calling the model — or resets any value to the agent's own design, also for 0 tokens.",
    span: "md:col-span-2",
    accent: "teal",
  },
  {
    title: "Deliverables bar",
    body: "One click each: a standalone FreeCAD macro, STEP/STL, a dimensioned 2D drawing and a costed BOM with a tip-over check. None of them cost tokens.",
    span: "",
    accent: "amber",
  },
  {
    title: "Real-time streaming",
    body: "Replies stream token by token, and Stop interrupts the model's HTTP stream itself, not just the display.",
    span: "",
    accent: "teal",
  },
  {
    title: "At most 2,000 tokens of tools per turn",
    body: "A phase-gated state machine picks the tool schemas each turn sees. Across the offline evals no turn exceeds 2,000 tokens — small enough for an 8 GB GPU's 8,192-token context.",
    span: "md:col-span-2",
    accent: "amber",
  },
];
---

<section id="features" class="border-t border-ink-600 bg-ink-800/40">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div data-reveal class="max-w-2xl">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">
        Built like a CAD engineer, not a chatbot.
      </h2>
      <p class="mt-3 text-slate-400">
        What a session gives you besides the conversation.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
      {
        features.map((f) => (
          <article data-reveal class:list={["bento-card", f.span]}>
            <div
              class:list={[
                "mb-4 h-1 w-12",
                f.accent === "teal" ? "bg-teal" : "bg-amber",
              ]}
            />
            <h3 class="text-lg font-semibold text-white">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
