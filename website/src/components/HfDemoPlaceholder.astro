---
/**
 * Stage 9.1 — Demo route points at the global REST chat (no iframe).
 */
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Talk to Dānā over REST",
  subtitle =
    "The floating command bar on every page POSTs to the Hugging Face / Gradio API. No iframe — same session history site-wide (Cmd/Ctrl+K).",
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-10 sm:py-14">
  <div class="max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-soft">
      /demo · REST
    </p>
    <h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{title}</h1>
    <p class="mt-3 text-slate-400">{subtitle}</p>
  </div>

  <div
    class="relative mt-10 overflow-hidden rounded-2xl border border-teal/40 bg-ink-900/80 p-8 shadow-teal-glow"
  >
    <ol class="space-y-4 text-sm leading-relaxed text-slate-300">
      <li>
        <span class="font-semibold text-teal-soft">1.</span>
        Set <code class="text-slate-100">PUBLIC_DANA_HF_API</code> in
        <code class="text-slate-100">website/.env</code> to your Space root
        (example: <code class="text-teal-soft">https://ORG-dana-agent.hf.space</code>).
      </li>
      <li>
        <span class="font-semibold text-teal-soft">2.</span>
        Use the bottom bar or press
        <kbd class="rounded border border-slate-600 bg-ink-950 px-1.5 py-0.5 text-xs"
          >Ctrl</kbd
        >+<kbd
          class="rounded border border-slate-600 bg-ink-950 px-1.5 py-0.5 text-xs"
          >K</kbd
        > anywhere on the site.
      </li>
      <li>
        <span class="font-semibold text-teal-soft">3.</span>
        Replies render as
        <span class="italic text-teal">[User (Text)]</span> /
        <span class="font-medium text-white">[Dānā]</span>. Cold boots surface
        “Dānā is warming up…”.
      </li>
    </ol>
    <p class="mt-8 text-xs text-slate-500">
      Client: <code class="text-slate-400">src/utils/hf_api.ts</code> →
      <code class="text-slate-400">POST /api/predict</code> with
      <code class="text-slate-400">&#123; data: [prompt] &#125;</code>.
    </p>
  </div>
</section>
