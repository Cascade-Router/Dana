---
/**
 * Stage 9.0 — floating / glowing brand mark.
 * Transform + opacity only (composite-friendly; no layout shift).
 */
---

<div class="relative mx-auto flex h-44 w-44 items-center justify-center sm:h-56 sm:w-56">
  <div
    class="pointer-events-none absolute inset-6 rounded-full bg-teal/30 animate-glow-pulse shadow-logo-glow"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-10 rounded-full bg-violet/20 blur-2xl"
    aria-hidden="true"
  >
  </div>
  <img
    src="/dana-logo.png"
    alt="Dānā mark"
    width="224"
    height="224"
    class="relative z-10 h-36 w-36 object-contain drop-shadow-[0_0_24px_rgba(0,173,181,0.45)] animate-floaty sm:h-44 sm:w-44"
    decoding="async"
    fetchpriority="high"
  />
</div>
