---
import { withBase } from "../utils/withBase";

const links = [
  { href: withBase("#features"), label: "Features" },
  { href: withBase("#routing"), label: "Routing" },
  { href: withBase("demo"), label: "Demo" },
  {
    href: "https://github.com/Cascade-Router/Donna",
    label: "GitHub",
    external: true,
  },
];
---

<header class="relative z-20 mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
  <a href={withBase()} class="group flex items-center gap-3 text-white">
    <img
      src={withBase("dana-logo.png")}
      alt="Dānā"
      width="36"
      height="36"
      class="h-9 w-9 object-contain"
      decoding="async"
    />
    <span class="text-lg font-semibold tracking-tight">Dānā</span>
  </a>
  <nav class="flex items-center gap-5 text-sm font-medium text-slate-300" aria-label="Primary">
    {
      links.map((link) =>
        link.external ? (
          <a
            href={link.href}
            class="transition hover:text-teal-soft"
            rel="noopener noreferrer"
            target="_blank"
          >
            {link.label}
          </a>
        ) : (
          <a href={link.href} class="transition hover:text-teal-soft">
            {link.label}
          </a>
        ),
      )
    }
  </nav>
</header>
