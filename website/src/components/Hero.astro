---
import HeroTerminal from "./HeroTerminal.astro";
import { withBase } from "../utils/withBase";

const repoHref = "https://github.com/Cascade-Router/Dana";
const hfSpaceHref = "https://huggingface.co/spaces/AMIXXM/Dana";
---

<section class="relative overflow-hidden">
  <div class="trace-grid absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div
    class="relative mx-auto grid max-w-6xl items-center gap-10 px-6 pb-20 pt-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:pb-28 lg:pt-16"
  >
    <div class="order-2 min-w-0 lg:order-1">
      <p
        class="animate-fade-up font-mono text-xs font-medium uppercase tracking-[0.2em] text-teal sm:text-sm"
      >
        Dānā
      </p>
      <h1
        class="mt-5 max-w-xl text-4xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl"
        style="animation-delay: 60ms"
      >
        Describe a part. Get a verified FreeCAD model.
      </h1>
      <p class="mt-6 max-w-lg text-base leading-relaxed text-slate-300 sm:text-lg">
        An open-source LLM agent that plans the build, drives a real FreeCAD kernel
        through ~90 typed tools, checks its own geometry and exports a macro that
        rebuilds the part without the agent — on a local 8 GB GPU or free-tier cloud
        models.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={repoHref}
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex min-h-[3rem] items-center justify-center rounded-none border border-amber bg-transparent px-7 text-sm font-semibold text-amber transition hover:bg-amber/10 focus:outline-none focus-visible:ring-1 focus-visible:ring-amber"
        >
          View on GitHub
        </a>
        <a
          href={hfSpaceHref}
          class="inline-flex min-h-[3rem] items-center justify-center rounded-none border border-teal bg-transparent px-7 text-sm font-semibold text-teal transition hover:bg-teal/10 focus:outline-none focus-visible:ring-1 focus-visible:ring-teal"
          rel="noopener noreferrer"
          target="_blank"
        >
          Open Hugging Face Space
        </a>
        <a
          href={withBase("#demo")}
          class="text-sm font-medium text-slate-400 underline-offset-4 transition hover:text-teal hover:underline"
        >
          Embed below
        </a>
      </div>
      <p class="mt-3 font-mono text-xs text-slate-500">
        FreeCAD · FastAPI + WebSockets · React/Tauri · Ollama or cloud models · AGPL-3.0
      </p>
    </div>

    <div class="order-1 flex min-w-0 justify-center lg:order-2 lg:justify-end" aria-hidden="false">
      <HeroTerminal />
    </div>
  </div>
</section>
