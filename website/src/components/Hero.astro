---
import FloatingLogo from "./FloatingLogo.astro";

const downloadHref =
  "https://github.com/Cascade-Router/Donna/releases/latest/download/Donna-windows-x64.zip";
---

<section class="relative overflow-hidden">
  <div class="trace-grid absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div
    class="relative mx-auto grid max-w-6xl items-center gap-10 px-6 pb-20 pt-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:pb-28 lg:pt-14"
  >
    <div class="order-2 lg:order-1">
      <p
        class="animate-fade-up text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl"
      >
        Dānā
        <span class="mt-1 block text-2xl font-medium text-teal-soft sm:text-3xl"
          >دانا</span
        >
      </p>
      <h1
        class="mt-5 max-w-xl text-xl font-medium leading-snug text-slate-100 sm:text-2xl"
        style="animation-delay: 80ms"
      >
        Cybernetic copilot. Local by design.
      </h1>
      <p class="mt-4 max-w-lg text-base leading-relaxed text-slate-300 sm:text-lg">
        Windows-native LangGraph agent with Distil-Whisper, Florence-2, and CUDA
        float16 — zero cloud round-trips, half-duplex voice, HITL-safe tickets.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          id="download-btn"
          href={downloadHref}
          class="inline-flex min-h-[3.25rem] items-center justify-center rounded-xl bg-teal px-8 text-base font-semibold text-ink-950 transition hover:bg-teal-soft focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-soft focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900"
        >
          Download for Windows
        </a>
        <a
          href="/demo"
          class="text-sm font-medium text-slate-400 underline-offset-4 transition hover:text-violet-soft hover:underline"
        >
          Open live demo
        </a>
      </div>
      <p id="os-hint" class="mt-3 text-xs text-slate-500" aria-live="polite">
        Windows 10/11 · NVIDIA RTX recommended (8GB+ VRAM) · local · offline-first
      </p>
    </div>

    <div class="order-1 flex justify-center lg:order-2 lg:justify-end" aria-hidden="false">
      <FloatingLogo />
    </div>
  </div>
</section>
