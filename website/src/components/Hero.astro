---
import FloatingLogo from "./FloatingLogo.astro";
import { withBase } from "../utils/withBase";

const downloadHref =
  "https://github.com/Cascade-Router/Dana/releases";
const hfSpaceHref = "https://huggingface.co/spaces/AMIXXM/Dana";
---

<section class="relative overflow-hidden">
  <div class="trace-grid absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div
    class="relative mx-auto grid max-w-6xl items-center gap-10 px-6 pb-20 pt-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:pb-28 lg:pt-14"
  >
    <div class="order-2 lg:order-1">
      <p
        class="animate-fade-up text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl"
      >
        Dānā
      </p>
      <h1
        class="mt-4 max-w-xl font-mono text-sm font-medium uppercase tracking-[0.14em] text-teal sm:text-base"
        style="animation-delay: 60ms"
      >
        Cybernetic Control-Plane Simulator
      </h1>
      <p class="mt-4 max-w-lg text-base leading-relaxed text-slate-300 sm:text-lg">
        Multi-agent orchestration for autonomous engineering — Meta-Broker corridor,
        epic task tracking, and offline-first routing on your machine.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          id="download-btn"
          href={downloadHref}
          class="inline-flex min-h-[3rem] items-center justify-center rounded-none border border-amber bg-transparent px-7 text-sm font-semibold text-amber transition hover:bg-amber/10 focus:outline-none focus-visible:ring-1 focus-visible:ring-amber"
        >
          Download for Windows
        </a>
        <a
          href={hfSpaceHref}
          class="inline-flex min-h-[3rem] items-center justify-center rounded-none border border-teal bg-transparent px-7 text-sm font-semibold text-teal transition hover:bg-teal/10 focus:outline-none focus-visible:ring-1 focus-visible:ring-teal"
          rel="noopener noreferrer"
          target="_blank"
        >
          Open Hugging Face Space
        </a>
        <a
          href={withBase("#demo")}
          class="text-sm font-medium text-slate-400 underline-offset-4 transition hover:text-teal hover:underline"
        >
          Embed below
        </a>
      </div>
      <p id="os-hint" class="mt-3 font-mono text-xs text-slate-500" aria-live="polite">
        Windows 10/11 · local Meta-Broker · headless control plane
      </p>
    </div>

    <div class="order-1 flex justify-center lg:order-2 lg:justify-end" aria-hidden="false">
      <FloatingLogo />
    </div>
  </div>
</section>
