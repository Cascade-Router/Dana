---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-slate-800/80">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-10 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      <span class="font-semibold text-slate-300">Dānā (دانا)</span>
      <span class="mx-2 text-slate-700">·</span>
      local · offline-first · © {year}
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={`${base}demo`} class="hover:text-teal-soft">Live Demo</a>
      <a href={`${base}terminal`} class="hover:text-teal-soft">Terminal</a>

      <a
        href="https://github.com/Cascade-Router/Donna"
        class="hover:text-teal-soft"
        rel="noopener noreferrer"
        target="_blank"
      >
        GitHub
      </a>
    </div>
  </div>
</footer>
