---
import { withBase } from "../utils/withBase";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-600">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-10 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      <span class="font-semibold text-slate-300">Dānā</span>
      <span class="mx-2 text-slate-700">·</span>
      cybernetic control plane · © {year}
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={withBase("#demo")} class="hover:text-teal">Live Demo</a>
      <a href={withBase("terminal")} class="hover:text-teal">Terminal</a>

      <a
        href="https://github.com/Cascade-Router/Dana"
        class="hover:text-teal"
        rel="noopener noreferrer"
        target="_blank"
      >
        GitHub
      </a>
    </div>
  </div>
</footer>
