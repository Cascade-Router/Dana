---
/**
 * Landing-page embed of the Hugging Face Gradio Space. Native iframe avoids
 * CORS / web-component status errors from ``<gradio-app>``.
 */
const spaceSrc = "https://amixxm-dana.hf.space";
const spacePageUrl = "https://huggingface.co/spaces/AMIXXM/Dana";
---

<section id="demo" class="scroll-mt-24 py-12 px-4 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="mb-6 text-center" data-reveal>
      <h2 class="text-2xl font-bold text-white sm:text-3xl">
        Try it on Hugging Face
      </h2>
      <p class="mx-auto mt-2 max-w-2xl text-sm text-slate-400">
        The hosted demo runs the real agent loop on Dānā's mock CAD engine (the Space has
        no FreeCAD): plan, build, query topology and check printability from the chat.
      </p>
      <p class="mt-3 text-xs text-slate-500">
        <a
          href={spacePageUrl}
          class="font-medium text-teal-soft underline-offset-4 transition hover:underline"
          rel="noopener noreferrer"
          target="_blank"
        >
          Open on Hugging Face Spaces
        </a>
      </p>
    </div>

    <div
      class="overflow-hidden rounded-none border border-ink-600 bg-ink-900"
      data-reveal
    >
      <iframe
        title="Dānā on Hugging Face Spaces"
        src={spaceSrc}
        frameborder="0"
        class="block w-full bg-ink-900"
        style="width: 100%; height: 750px; border-radius: 12px; border: 1px solid #1e293b;"
        loading="lazy"
        allow="accelerometer; camera; microphone; gpu; clipboard-write"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </div>
</section>
