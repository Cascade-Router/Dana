---
/**
 * Landing-page embed of the Hugging Face Gradio Space (ZeroGPU simulator).
 * Uses the official `<gradio-app>` web component — not an iframe.
 */
const spaceSrc = "https://amixxm-donna.hf.space";
const spacePageUrl = "https://huggingface.co/spaces/AMIXXM/Donna";
---

<section id="demo" class="scroll-mt-24 py-12 px-4 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="mb-6 text-center" data-reveal>
      <h2 class="text-2xl font-bold text-white sm:text-3xl">
        Live Cybernetic Simulator
      </h2>
      <p class="mx-auto mt-2 max-w-2xl text-sm text-slate-400">
        Test Dānā's LangGraph routing corridor and Florence-2 UI grounding live on
        ZeroGPU
      </p>
      <p class="mt-3 text-xs text-slate-500">
        <a
          href={spacePageUrl}
          class="font-medium text-teal-soft underline-offset-4 transition hover:underline"
          rel="noopener noreferrer"
          target="_blank"
        >
          Open on Hugging Face Spaces
        </a>
      </p>
    </div>

    <div
      class="overflow-hidden rounded-2xl border border-slate-800 bg-[#0b0f17] shadow-2xl"
      data-reveal
    >
      <gradio-app src={spaceSrc} theme_mode="dark" eager="true"></gradio-app>
    </div>
  </div>
</section>

<script
  is:inline
  type="module"
  src="https://gradio.s3-us-west-2.amazonaws.com/5.49.1/gradio.js"
></script>
