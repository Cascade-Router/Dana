---
/**
 * Architecture pillars, alongside BentoGrid's session features: same
 * `.bento-card` + grid convention (global.css, BentoGrid.astro) so the two
 * read as one system.
 */
const pillars = [
  {
    title: "Deterministic verification",
    body: "The model never grades its own geometry. B-Rep topology, exact boolean intersection for collisions, mass properties and mesh checks decide whether a part is right.",
    accent: "teal",
  },
  {
    title: "One IR, four consumers",
    body: "Live tool calls, the exported macro, compiled skills and parametric rebuilds all render the same typed steps, so a session replays the same way every time.",
    accent: "amber",
  },
  {
    title: "Self-correction against real gates",
    body: "Invalid arguments, out-of-order tools and unmeasured placements are rejected with a reason the model can act on, and it retries — counted in every eval run.",
    accent: "teal",
  },
];
---

<section id="architecture" class="scroll-mt-24 border-t border-ink-600 bg-ink-900">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div data-reveal class="max-w-2xl">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">
        A CAD agent built to be audited, not trusted.
      </h2>
      <p class="mt-3 text-slate-400">
        Three guarantees that hold whether or not a human is watching the session.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        pillars.map((p) => (
          <article data-reveal class="bento-card">
            <div class:list={["mb-4 h-1 w-12", p.accent === "teal" ? "bg-teal" : "bg-amber"]} />
            <h3 class="text-lg font-semibold text-white">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
