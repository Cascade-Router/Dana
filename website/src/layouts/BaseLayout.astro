---
import "../styles/global.css";
import GlobalChat from "../components/GlobalChat.astro";
import { withBase } from "../utils/withBase";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = "Dānā — Zero-Trust Autonomous CAD",
  description =
    "Dānā is an autonomous CAD orchestrator: deterministic verification, topological lineage through destructive operations, and self-healing scripts — offline-first, on your machine.",
  path = "/",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const pathname = `${base}${path.replace(/^\//, "")}`.replace(/\/{2,}/g, "/");
const canonical = new URL(pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d1117" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <!-- Only the typed webp preload — a browser without webp support just
         skips it (falling back to the normal, un-preloaded <picture> PNG
         fetch); an unconditional second PNG preload here would double-fetch
         the logo on every webp-capable browser instead. -->
    <link
      rel="preload"
      as="image"
      href={withBase("dana-logo.webp")}
      type="image/webp"
      fetchpriority="high"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body class="font-sans">
    <slot />
    <GlobalChat />
    <script>
      // Lightweight IntersectionObserver reveal (no animation libs on critical path).
      const nodes = document.querySelectorAll("[data-reveal]");
      if (nodes.length && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        nodes.forEach((el) => io.observe(el));
      } else {
        nodes.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
