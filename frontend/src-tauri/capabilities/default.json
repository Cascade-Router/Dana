{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capabilities for Dana's main, orb, and dynamically-spawned plugin windows.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:allow-create-webview-window",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "store:default",
    "dialog:default"
  ]
}
