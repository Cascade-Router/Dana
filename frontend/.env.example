# Set this to build a static frontend (e.g. Vercel/GitHub Pages) that talks
# to the Hugging Face Space's Gradio chat API instead of the native
# /ws/chat WebSocket (used for the Tauri desktop app and any other build
# served by dana.api.server itself). Leave unset/empty for the WebSocket
# path — that's the default. See src/lib/useChat.ts.
VITE_HF_SPACE_URL=
